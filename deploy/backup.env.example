# Copy to /etc/omoiyari-backup.env and fill in. chmod 600.
#
# Restore settings (uncomment if your paths differ from the defaults):
# APP_DIR=/srv/omoiyari-pos
# BACKUP_DIR=/srv/omoiyari-pos/backups
# MEDIA_DIR=/srv/omoiyari-pos/media
# KEEP_LOCAL_DAYS=7
#
# The script defaults to POSTGRES_USER=omoiyari and POSTGRES_DB=omoiyari. Set
# these only if deploy/.env uses different names:
# POSTGRES_USER=omoiyari
# POSTGRES_DB=omoiyari

# --- Cloudflare R2 (restic S3 backend) ------------------------------------
# Create a bucket, then an R2 API token with Object Read & Write on it.
# RESTIC_REPOSITORY format: s3:<endpoint>/<bucket>
RESTIC_REPOSITORY="s3:https://<ACCOUNT_ID>.r2.cloudflarestorage.com/omoiyari-backups"
AWS_ACCESS_KEY_ID="<R2 access key id>"
AWS_SECRET_ACCESS_KEY="<R2 secret access key>"
AWS_DEFAULT_REGION="auto"
# restic encrypts client-side; store this password in a password manager too.
# Without it the off-site backup cannot be restored.
RESTIC_PASSWORD="<long random passphrase>"

# Optional: cap restic's bandwidth (KiB/s) so backups never starve the POS.
# RESTIC_LIMIT_UPLOAD=4096
# RESTIC_LIMIT_DOWNLOAD=0
