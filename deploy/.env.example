# Copy to deploy/.env and fill in. deploy/.env is gitignored and CI never
# overwrites it. These are the variables the app reads at runtime (see
# src/lib/server/db.ts, src/lib/auth.ts).

# Postgres credentials for the `db` service. The password may contain any
# character, but keep it URL-safe (letters, digits, - _) so it can be pasted
# into DATABASE_URL below without percent-encoding.
POSTGRES_DB="omoiyari"
POSTGRES_USER="omoiyari"
POSTGRES_PASSWORD=""

# Where the app connects. This is NOT built by compose: during the
# Supabase → native cutover the VPS keeps the Supabase URL here until the data
# has been restored, so a normal deploy cannot switch the app to an empty
# database. Change it to the native URL only at cutover:
#
#   DATABASE_URL="postgresql://omoiyari:<POSTGRES_PASSWORD>@db:5432/omoiyari"
#
# Use `db` as the host (not 127.0.0.1) — that is the compose service name.
DATABASE_URL=""

# The public HTTPS origin. MUST match the Caddyfile hostname.
# Changing this invalidates existing passkeys — see README.
BETTER_AUTH_URL="https://pos.example.com"

# openssl rand -hex 32  (keep the existing production value if you have one)
BETTER_AUTH_SECRET=""

# Bearer token for /api/keepalive. Optional; the route is unused with a native
# database but harmless to keep.
CRON_SECRET=""
