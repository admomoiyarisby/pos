# Copy to deploy/.env and fill in. deploy/.env is gitignored.
# These are exactly the variables the app reads at runtime (see src/lib/server/db.ts,
# src/lib/auth.ts, src/lib/server/supabase.ts).

# Supabase transaction-mode pooler (port 6543). Keep the pooler host as-is.
DATABASE_URL="postgresql://postgres.<ref>:<password>@aws-1-ap-southeast-1.pooler.supabase.com:6543/postgres"

# The public HTTPS origin. MUST match the Caddyfile hostname.
# Changing this invalidates existing passkeys — see README.
BETTER_AUTH_URL="https://pos.example.com"

# openssl rand -hex 32  (keep the existing production value if you have one)
BETTER_AUTH_SECRET=""

# Supabase project (used for recipe image storage).
SUPABASE_URL="https://<ref>.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Bearer token for /api/keepalive. Optional; if unset the endpoint is open.
CRON_SECRET=""
