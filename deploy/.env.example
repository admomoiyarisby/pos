# Copy to deploy/.env and fill in. deploy/.env is gitignored.
# These are the variables the app reads at runtime (see src/lib/server/db.ts,
# src/lib/auth.ts). Compose builds DATABASE_URL from the POSTGRES_* values.

# Postgres credentials for the `db` service. POSTGRES_PASSWORD must be
# URL-safe (letters, digits, - _): compose interpolates it into DATABASE_URL.
POSTGRES_DB="omoiyari"
POSTGRES_USER="omoiyari"
POSTGRES_PASSWORD=""

# The public HTTPS origin. MUST match the Caddyfile hostname.
# Changing this invalidates existing passkeys — see README.
BETTER_AUTH_URL="https://pos.example.com"

# openssl rand -hex 32  (keep the existing production value if you have one)
BETTER_AUTH_SECRET=""

# Bearer token for /api/keepalive. Optional; the route is unused with a native
# database but harmless to keep.
CRON_SECRET=""
