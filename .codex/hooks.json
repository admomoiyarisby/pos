{
  "description": "Impeccable design detector: runs after Edit/Write/apply_patch on UI files and surfaces findings as system reminders.",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/root/.agents/skills/impeccable/scripts/hook.mjs' ] || node '/root/.agents/skills/impeccable/scripts/hook.mjs'",
            "timeout": 5,
            "statusMessage": "Checking UI changes",
            "commandWindows": "if exist \"/root/.agents/skills/impeccable/scripts/hook.mjs\" (node \"/root/.agents/skills/impeccable/scripts/hook.mjs\" & exit /b)"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "[ ! -f '/root/.agents/skills/impeccable/scripts/hook.mjs' ] || node '/root/.agents/skills/impeccable/scripts/hook.mjs'",
            "timeout": 30,
            "statusMessage": "Design deep pass",
            "commandWindows": "if exist \"/root/.agents/skills/impeccable/scripts/hook.mjs\" (node \"/root/.agents/skills/impeccable/scripts/hook.mjs\" & exit /b)"
          }
        ]
      }
    ]
  }
}
