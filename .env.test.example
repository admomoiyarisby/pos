# Isolated local PostgreSQL database for integration tests.
# Start it with: docker compose -f docker-compose.test.yml up -d
TEST_DATABASE_URL=postgresql://omoiyari_test:omoiyari_test@localhost:5433/omoiyari_pos_test

# The integration tests currently read DATABASE_URL.
# Export TEST_DATABASE_URL as DATABASE_URL when running them:
# DATABASE_URL="$TEST_DATABASE_URL" vp test run
